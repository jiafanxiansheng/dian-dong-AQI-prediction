# ═══════════════════════════════════════════════════════════════
# 清新小助手 — 环境变量配置模板
# 使用方式: 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── 数据库配置 ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=air_data

# ─── DeepSeek API ───────────────────────────────────────
# 获取 API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ─── Flask 服务 ─────────────────────────────────────────
FLASK_DEBUG=false
FLASK_PORT=5000
